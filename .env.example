# Copy to .env (never commit it) only if you run a REAL model-backed router.
# Tests, examples and the default benchmark need none of these.

# Anthropic (integrations/anthropic_llm.py). Alternatively use `ant auth login`.
ANTHROPIC_API_KEY=
# Optional model override for AnthropicLLMAdapter (default: claude-opus-5).
JEVPILOT_ANTHROPIC_MODEL=
