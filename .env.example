# Copy to .env (git-ignored; never commit it) only to run REAL model-backed components.
# Every value stays empty here. Tests, examples and the offline demo need none of these.
#   jevpilot uav-materials --live-routing   needs TYPESAFE_API_KEY
#   jevpilot uav-materials --live           needs TYPESAFE_API_KEY and ANTHROPIC_API_KEY

# Jev (TypeSafe System One), integrations/typesafe_jev.py.
TYPESAFE_API_KEY=
# Optional; default: discovered from GET /v1/models (most recently released model).
TYPESAFE_DEFAULT_MODEL=

# Anthropic, for requirement interpretation (native adapter or LangChain).
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5).
JEVPILOT_ANTHROPIC_MODEL=
# Optional LangChain chat model as provider:model (default: anthropic + the model above).
JEVPILOT_LANGCHAIN_MODEL=

# Opt-in live tests: set to 1 (the pytest marker `live_jev` also selects the Jev ones).
JEVPILOT_LIVE_TESTS=
