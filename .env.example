# Copy to .env (never commit it) only if you run a REAL model-backed router.
# `jevpilot uav-materials --live` needs ANTHROPIC_API_KEY and TYPESAFE_API_KEY.
# Tests, examples and the default benchmark need none of these.

# Anthropic (integrations/anthropic_llm.py). Alternatively use `ant auth login`.
ANTHROPIC_API_KEY=
# Optional model override for AnthropicLLMAdapter (default: claude-opus-5).
JEVPILOT_ANTHROPIC_MODEL=

# Jev (TypeSafe System One) for integrations/typesafe_jev.py.
TYPESAFE_API_KEY=
# Optional model override (SDK default: jev-latest).
TYPESAFE_DEFAULT_MODEL=
# Opt-in live smoke tests (one minimal real call per provider).
JEVPILOT_LIVE_TESTS=0
