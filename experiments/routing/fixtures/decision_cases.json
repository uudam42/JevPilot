{
  "benchmark": "jevpilot.routing.decisions",
  "version": "1",
  "suite": "pipeline",
  "capability_catalog": {
    "pipe.fetch": {
      "description": "Fetch raw records from a source location.",
      "input_schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      },
      "tags": [
        "acquire"
      ],
      "effects": [
        "adds a raw dataset artifact",
        "sets context.raw"
      ],
      "domain": "pipeline"
    },
    "pipe.fetch_mirror": {
      "description": "Fetch the same raw records from a read-only mirror of the source.",
      "input_schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      },
      "tags": [
        "acquire"
      ],
      "effects": [
        "adds a raw dataset artifact",
        "sets context.raw"
      ],
      "domain": "pipeline"
    },
    "pipe.parse": {
      "description": "Parse the fetched raw records into structured rows.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "preconditions": [
        "raw records fetched"
      ],
      "effects": [
        "sets context.parsed"
      ],
      "domain": "pipeline"
    },
    "pipe.validate": {
      "description": "Check parsed rows for consistency; reports issues if any are found.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "preconditions": [
        "records parsed"
      ],
      "effects": [
        "sets context.validated to true or false"
      ],
      "domain": "pipeline"
    },
    "pipe.clean": {
      "description": "Remove duplicate and incomplete rows. Validation must be re-run afterwards.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "preconditions": [
        "records parsed"
      ],
      "effects": [
        "sets context.cleaned",
        "clears context.validated"
      ],
      "domain": "pipeline"
    },
    "pipe.summarize": {
      "description": "Summarize validated rows in the requested style.",
      "input_schema": {
        "type": "object",
        "properties": {
          "style": {
            "type": "string",
            "enum": [
              "brief",
              "detailed"
            ]
          }
        },
        "required": [
          "style"
        ],
        "additionalProperties": false
      },
      "preconditions": [
        "records validated"
      ],
      "effects": [
        "adds a candidate summary",
        "sets context.summarized"
      ],
      "domain": "pipeline"
    },
    "pipe.publish": {
      "description": "Publish the summary on a channel. Irreversible.",
      "input_schema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "internal",
              "public"
            ]
          }
        },
        "required": [
          "channel"
        ],
        "additionalProperties": false
      },
      "preconditions": [
        "summary exists"
      ],
      "effects": [
        "sets context.published"
      ],
      "side_effects": true,
      "domain": "pipeline"
    },
    "pipe.cleanup_cache": {
      "description": "Clear the local scratch cache. Never required to reach any goal.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "tags": [
        "maintenance"
      ],
      "domain": "pipeline"
    }
  },
  "cases": [
    {
      "case_id": "seq_01_fetch_first",
      "pattern": "sequential_dependency",
      "description": "Nothing done yet; either fetch capability is a correct first step.",
      "state": {
        "goal": {
          "description": "publish a validated summary of the records on the internal channel",
          "parameters": {
            "source": "store://records/2026-q3"
          },
          "success_criteria": {
            "channel": "internal"
          }
        }
      },
      "capabilities": [
        "pipe.fetch",
        "pipe.fetch_mirror",
        "pipe.cleanup_cache"
      ],
      "expected": {
        "valid_capabilities": [
          "pipe.fetch",
          "pipe.fetch_mirror"
        ],
        "unnecessary_capabilities": [
          "pipe.cleanup_cache"
        ],
        "required_inputs": {
          "pipe.fetch": {
            "source": "store://records/2026-q3"
          },
          "pipe.fetch_mirror": {
            "source": "store://records/2026-q3"
          }
        }
      }
    },
    {
